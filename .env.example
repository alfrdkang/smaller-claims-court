# ---- Required: the judge -----------------------------------------------------
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# ---- Required for spoken verdicts and voice testimony ------------------------
# https://elevenlabs.io/app/settings/api-keys
# Without this the app still works; rulings are simply delivered in silence.
ELEVENLABS_API_KEY=

# ---- Optional: branding ------------------------------------------------------
# Appears in the header and on the PDF letterhead.
NEXT_PUBLIC_COURT_NAME="Petty Disputes Division"
# Only needed if share links / QR codes must point somewhere other than the
# request host (Vercel sets this up for you automatically).
NEXT_PUBLIC_BASE_URL=

# ---- Optional: tuning --------------------------------------------------------
# low (default) keeps a live demo snappy; medium/high write more elaborate rulings.
JUDGE_EFFORT=low
JUDGE_MODEL=claude-opus-5
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_STT_MODEL_ID=scribe_v1

# ---- Optional: per-judge voices ----------------------------------------------
# Any voice id from https://elevenlabs.io/app/voice-library
ELEVENLABS_VOICE_GRIMSBY=
ELEVENLABS_VOICE_VEX=
ELEVENLABS_VOICE_CALLOWAY=
ELEVENLABS_VOICE_APPELLATE=

# ---- Optional: persistence ---------------------------------------------------
# Without these, cases live in process memory: perfect for a laptop demo, but
# share links break across serverless cold starts. Set both to keep the docket
# alive on Vercel. Free database at https://console.upstash.com/redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
